<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RS TOKEN - Admin Panel PRO</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #050b14; color: #f8fafc; }
        .glass-card { background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 41, 59, 0.6) 100%); backdrop-filter: blur(12px); border: 1px solid rgba(59, 130, 246, 0.2); }
        .sidebar-item:hover, .sidebar-item.active { background: linear-gradient(90deg, rgba(37, 99, 235, 0.4) 0%, rgba(15, 23, 42, 0) 100%); border-left: 4px solid #3b82f6; }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <!-- Sidebar -->
    <aside class="w-64 bg-[#030712] border-r border-slate-800 flex flex-col justify-between hidden md:flex">
        <div>
            <div class="p-5 flex items-center space-x-3 border-b border-slate-800/80">
                <div class="bg-gradient-to-tr from-amber-500 to-yellow-300 p-2 rounded-xl text-black font-black text-xl shadow-lg shadow-amber-500/20">RS</div>
                <div>
                    <h1 class="font-bold text-lg tracking-wide bg-gradient-to-r from-amber-400 to-yellow-200 bg-clip-text text-transparent">RS TOKEN</h1>
                    <span class="text-[10px] bg-blue-600/30 text-blue-400 px-2 py-0.5 rounded border border-blue-500/30 font-semibold">ADMIN PANEL PRO</span>
                </div>
            </div>
            <nav class="p-4 space-y-1.5 text-sm">
                <a href="#" class="sidebar-item active flex items-center space-x-3 px-4 py-3 rounded-xl text-blue-400 font-medium"><i class="fa-solid fa-chart-pie w-5"></i><span>Dashboard</span></a>
                <a href="#" class="sidebar-item flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white transition"><i class="fa-solid fa-users w-5"></i><span>User Management</span></a>
                <a href="#" class="sidebar-item flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white transition"><i class="fa-solid fa-wallet w-5"></i><span>Deposit History</span></a>
                <a href="#" class="sidebar-item flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white transition"><i class="fa-solid fa-money-bill-transfer w-5"></i><span>Withdraw History</span></a>
                <a href="#" class="sidebar-item flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white transition"><i class="fa-solid fa-gear w-5"></i><span>Settings</span></a>
            </nav>
        </div>
        <div class="p-4 border-t border-slate-800 text-center">
            <div class="glass-card p-3 rounded-xl border border-amber-500/20">
                <p class="text-xs text-amber-400 font-semibold">Bigger Community</p>
                <p class="text-[10px] text-slate-400">More Earning Together</p>
            </div>
            <span class="text-[11px] text-slate-500 mt-3 block">v1.0.0</span>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col h-screen overflow-y-auto">
        
        <!-- Header -->
        <header class="h-20 bg-[#030712]/80 backdrop-blur-md border-b border-slate-800 px-6 flex items-center justify-between sticky top-0 z-50">
            <div class="flex items-center space-x-4">
                <div class="flex items-center space-x-2 bg-emerald-500/10 border border-emerald-500/30 px-3 py-1.5 rounded-full">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-xs font-semibold text-emerald-400">System Online</span>
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <div class="flex items-center space-x-3 bg-slate-900/80 border border-slate-800 px-4 py-2 rounded-2xl">
                    <div class="bg-gradient-to-r from-amber-500 to-yellow-400 text-black font-bold w-9 h-9 rounded-xl flex items-center justify-center shadow">RS</div>
                    <div class="text-left">
                        <h4 class="text-sm font-bold text-white flex items-center gap-1">RS Rana <i class="fa-solid fa-crown text-amber-400 text-xs"></i></h4>
                        <span class="text-[10px] text-amber-400/80 font-medium">Super Admin</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Dashboard Body -->
        <main class="p-6 space-y-6 max-w-7xl mx-auto w-full">
            
            <!-- Welcome Banner -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center bg-gradient-to-r from-blue-900/30 via-slate-900/50 to-indigo-950/40 border border-blue-500/20 p-6 rounded-2xl shadow-xl">
                <div>
                    <h2 class="text-2xl font-bold flex items-center gap-2">Dashboard <span class="text-amber-400">👑</span></h2>
                    <p class="text-slate-400 text-sm mt-1">Welcome back, <span class="text-white font-semibold">RS Rana!</span> Here's what's happening with your RS Token Mini App.</p>
                </div>
                <button onclick="fetchUserData()" class="mt-4 md:mt-0 bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-xl text-sm font-semibold transition flex items-center gap-2 shadow-lg shadow-blue-600/30">
                    <i class="fa-solid fa-rotate"></i> Refresh Data
                </button>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="glass-card p-5 rounded-2xl border-l-4 border-l-blue-500">
                    <div class="flex justify-between items-start">
                        <div class="bg-blue-500/20 text-blue-400 p-3 rounded-xl"><i class="fa-solid fa-users text-xl"></i></div>
                        <span class="text-xs text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded font-semibold">+12.5%</span>
                    </div>
                    <h3 class="text-slate-400 text-xs font-medium mt-4">Total Users</h3>
                    <p id="total-users-count" class="text-2xl font-bold text-white mt-1">Loading...</p>
                </div>
                <div class="glass-card p-5 rounded-2xl border-l-4 border-l-emerald-500">
                    <div class="flex justify-between items-start">
                        <div class="bg-emerald-500/20 text-emerald-400 p-3 rounded-xl"><i class="fa-solid fa-user-check text-xl"></i></div>
                        <span class="text-xs text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded font-semibold">Online</span>
                    </div>
                    <h3 class="text-slate-400 text-xs font-medium mt-4">Active Members</h3>
                    <p class="text-2xl font-bold text-white mt-1">48,276</p>
                </div>
                <div class="glass-card p-5 rounded-2xl border-l-4 border-l-purple-500">
                    <div class="flex justify-between items-start">
                        <div class="bg-purple-500/20 text-purple-400 p-3 rounded-xl"><i class="fa-solid fa-wallet text-xl"></i></div>
                        <span class="text-xs text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded font-semibold">৳ 8.4M</span>
                    </div>
                    <h3 class="text-slate-400 text-xs font-medium mt-4">Total Deposits</h3>
                    <p class="text-2xl font-bold text-white mt-1">৳ 8,452,300</p>
                </div>
                <div class="glass-card p-5 rounded-2xl border-l-4 border-l-amber-500">
                    <div class="flex justify-between items-start">
                        <div class="bg-amber-500/20 text-amber-400 p-3 rounded-xl"><i class="fa-solid fa-coins text-xl"></i></div>
                        <span class="text-xs text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded font-semibold">20.4%</span>
                    </div>
                    <h3 class="text-slate-400 text-xs font-medium mt-4">Total RS Tokens</h3>
                    <p class="text-2xl font-bold text-white mt-1">2,458,600,000</p>
                </div>
            </div>

            <!-- Database Live Users List Section -->
            <div class="glass-card p-6 rounded-2xl border border-slate-800">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-bold text-white flex items-center gap-2"><i class="fa-solid fa-database text-blue-400"></i> Live Database Users</h3>
                    <span class="text-xs bg-blue-500/20 text-blue-400 px-3 py-1 rounded-full border border-blue-500/30 font-medium">MongoDB Connected</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-800 text-slate-400 text-xs uppercase">
                                <th class="py-3 px-4">User ID / Name</th>
                                <th class="py-3 px-4">Telegram ID</th>
                                <th class="py-3 px-4">Status</th>
                                <th class="py-3 px-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="users-table-body" class="text-sm divide-y divide-slate-800/60">
                            <tr>
                                <td colspan="4" class="text-center py-6 text-slate-400">Fetching data from database...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <!-- Script to Fetch Real Data from your Admin API -->
    <script>
        async function fetchUserData() {
            try {
                const response = await fetch('/api/admin/users');
                const users = await response.json();
                
                document.getElementById('total-users-count').innerText = users.length;
                
                const tableBody = document.getElementById('users-table-body');
                tableBody.innerHTML = '';

                if(users.length === 0) {
                    tableBody.innerHTML = `<tr><td colspan="4" class="text-center py-6 text-slate-400">No users found in database yet.</td></tr>`;
                    return;
                }

                users.forEach((user, index) => {
                    tableBody.innerHTML += `
                        <tr class="hover:bg-slate-800/40 transition">
                            <td class="py-3 px-4 font-medium text-white flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-blue-600/30 flex items-center justify-center text-blue-400 font-bold text-xs">#${index+1}</div>
                                ${user.username || user.name || 'User_' + (user._id ? user._id.slice(-5) : index)}
                            </td>
                            <td class="py-3 px-4 text-slate-300">${user.telegramId || user.chatId || 'N/A'}</td>
                            <td class="py-3 px-4"><span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2.5 py-1 rounded-full text-xs font-semibold">Active</span></td>
                            <td class="py-3 px-4 text-slate-400"><button class="text-blue-400 hover:text-blue-300 text-xs font-semibold bg-blue-500/10 px-3 py-1 rounded-lg">View</button></td>
                        </tr>
                    `;
                });
            } catch (error) {
                console.error('Error fetching users:', error);
                document.getElementById('total-users-count').innerText = 'Error';
                document.getElementById('users-table-body').innerHTML = `<tr><td colspan="4" class="text-center py-6 text-red-400">Failed to load user data from API.</td></tr>`;
            }
        }

        // Load data on page load
        fetchUserData();
    </script>
</body>
</html>
